{
  "name": "@splitshift/app",
  "displayName": "SplitShift",
  "version": "1.1.0",
  "description": "Client and project time tracking with invoices, optional due dates, CSV reports, and opt-in billing memory sharing.",
  "permissions": [
    "dialog:open",
    "vault:write",
    "vault:read"
  ],
  "updateStrategy": "git",
  "entrypoints": {
    "renderer": "index.html"
  },
  "widgets": [
    {
      "id": "splitshift-main",
      "icon": "🕒",
      "name": "SplitShift",
      "route": "index.html",
      "defaultWidth": 900,
      "defaultHeight": 700
    }
  ],
  "icon": "icon.svg",
  "repository": "https://github.com/loyallights/SplitShift",
  "license": "MIT"
}
